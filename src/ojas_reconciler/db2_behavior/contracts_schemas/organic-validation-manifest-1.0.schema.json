{
  "$defs": {
    "OrganicProcedureCase": {
      "additionalProperties": false,
      "properties": {
        "authored_for_tool": {
          "default": false,
          "title": "Authored For Tool",
          "type": "boolean"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "customer_authorization_ref": {
          "title": "Customer Authorization Ref",
          "type": "string"
        },
        "expected_platform": {
          "default": "DB2",
          "title": "Expected Platform",
          "type": "string"
        },
        "procedure_role_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedure Role Hint"
        },
        "source_must_remain_unmodified": {
          "default": true,
          "title": "Source Must Remain Unmodified",
          "type": "boolean"
        },
        "source_origin": {
          "default": "ORGANIC_CUSTOMER_SOURCE",
          "title": "Source Origin",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "source_path",
        "customer_authorization_ref"
      ],
      "title": "OrganicProcedureCase",
      "type": "object"
    },
    "OrganicValidationLevel": {
      "enum": [
        "ORGANIC_SMOKE",
        "DISCOVERY_SAMPLE",
        "ESTATE_PILOT"
      ],
      "title": "OrganicValidationLevel",
      "type": "string"
    }
  },
  "$id": "organic-validation-manifest-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/OrganicProcedureCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "custody_agreement_digest": {
      "title": "Custody Agreement Digest",
      "type": "string"
    },
    "custody_agreement_id": {
      "title": "Custody Agreement Id",
      "type": "string"
    },
    "customer_ref": {
      "title": "Customer Ref",
      "type": "string"
    },
    "estate_ref": {
      "title": "Estate Ref",
      "type": "string"
    },
    "schema_version": {
      "default": "organic-validation-manifest-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_id": {
      "title": "Validation Id",
      "type": "string"
    },
    "validation_level": {
      "$ref": "#/$defs/OrganicValidationLevel"
    }
  },
  "required": [
    "validation_id",
    "validation_level",
    "customer_ref",
    "estate_ref",
    "custody_agreement_id",
    "custody_agreement_digest",
    "cases",
    "content_digest"
  ],
  "title": "OrganicValidationManifest",
  "type": "object"
}
