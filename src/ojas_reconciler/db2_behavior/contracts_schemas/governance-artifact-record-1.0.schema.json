{
  "$defs": {
    "GovernanceArtifactType": {
      "enum": [
        "SCENARIO_SPEC_BATCH",
        "SCENARIO_SPEC",
        "CLASSIFICATION_OBSERVATION",
        "EFFECT_CLOSURE",
        "RESOLUTION_VECTOR",
        "ANALYSIS_BUDGET_REPORT",
        "BDD_COMPILATION_BATCH",
        "CANDIDATE_BDD",
        "TRACEABILITY_MANIFEST",
        "GHERKIN_ARTIFACT",
        "RUNTIME_VERIFICATION_BATCH",
        "RUNTIME_EXECUTION_RECORD",
        "RUNTIME_VERIFICATION_RESULT",
        "PLATFORM_DECISION",
        "CERTIFICATION_BINDING"
