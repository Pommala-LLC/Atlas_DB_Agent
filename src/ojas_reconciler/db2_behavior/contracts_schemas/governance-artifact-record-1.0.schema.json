    },
    "symbol_lineage_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Symbol Lineage Id"
    }
  },
  "required": [
    "artifact_id",
    "artifact_type",
    "artifact_ref",
    "content_digest",
    "payload_digest",
    "created_at"
  ],
  "title": "StoredArtifactRecord",
  "type": "object"
}
