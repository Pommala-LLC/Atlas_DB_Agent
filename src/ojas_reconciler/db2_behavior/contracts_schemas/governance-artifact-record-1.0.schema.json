    },
    "behavior_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Behavior Id"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "invalidates_machine_attestation": {
      "default": false,
      "title": "Invalidates Machine Attestation",
      "type": "boolean"
    },
    "parent_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Artifact Id"
    },
    "payload_digest": {
      "title": "Payload Digest",
      "type": "string"
    },
    "platform_governance_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
