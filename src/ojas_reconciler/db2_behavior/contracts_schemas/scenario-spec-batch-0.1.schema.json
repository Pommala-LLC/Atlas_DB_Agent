{
  "$defs": {
    "ClassificationAuthorityStatus": {
      "enum": [
        "APPROVED",
        "UNAPPROVED"
      ],
      "title": "ClassificationAuthorityStatus",
      "type": "string"
    },
    "ClassificationObservation": {
      "additionalProperties": false,
      "properties": {
        "authority_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Ref"
        },
        "authority_status": {
          "$ref": "#/$defs/ClassificationAuthorityStatus"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "classification_evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Classification Evidence Refs",
          "type": "array"
        },
        "classification_observation_id": {
          "title": "Classification Observation Id",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "ranking_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Score"
        },
        "score_semantics": {
          "anyOf": [
            {
              "const": "RANKING_ONLY",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Semantics"
        }
      },
      "required": [
        "classification_observation_id",
        "candidate",
        "method",
        "method_version",
        "authority_status"
      ],
      "title": "ClassificationObservation",
      "type": "object"
    },
    "EffectClosureArtifact": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/$defs/EffectClosureCompleteness"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "effect_closure_id": {
          "title": "Effect Closure Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "included_effect_refs": {
          "items": {
            "type": "string"
          },
          "title": "Included Effect Refs",
          "type": "array"
        },
        "scope": {
          "const": "ANALYZED_DEPENDENCIES",
          "default": "ANALYZED_DEPENDENCIES",
          "title": "Scope",
          "type": "string"
        },
        "unresolved_effect_refs": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Effect Refs",
          "type": "array"
        }
      },
      "required": [
        "effect_closure_id",
        "completeness",
        "included_effect_refs",
        "unresolved_effect_refs",
        "evidence_refs",
        "content_digest"
      ],
      "title": "EffectClosureArtifact",
      "type": "object"
    },
    "EffectClosureCompleteness": {
      "enum": [
        "DIRECT_EFFECT_ONLY",
        "PARTIAL_TRANSITIVE_CLOSURE",
        "CLOSED_WITHIN_SCOPE",
        "UNKNOWN"
      ],
      "title": "EffectClosureCompleteness",
      "type": "string"
    },
    "EffectModality": {
      "enum": [
        "MUST",
        "MUST_IF_CALLER_CONTRACT_HOLDS",
        "MAY",
        "MUST_NOT",
        "UNKNOWN"
      ],
      "title": "EffectModality",
      "type": "string"
    },
    "ResolutionStatus": {
      "enum": [
        "RESOLVED",
        "RESOLVED_SOURCE_ONLY",
        "NOT_APPLICABLE",
        "NOT_ASSESSED",
        "UNRESOLVED"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "ResolutionVectorArtifact": {
      "additionalProperties": false,
      "properties": {
        "constraint_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "dynamic_relation_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "resolution_vector_id": {
          "title": "Resolution Vector Id",
          "type": "string"
        },
        "routine_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "trigger_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "udf_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "view_resolution": {
          "$ref": "#/$defs/ResolutionStatus"
        }
      },
      "required": [
        "resolution_vector_id",
        "routine_resolution",
        "view_resolution",
        "udf_resolution",
        "trigger_resolution",
        "constraint_resolution",
        "dynamic_relation_resolution",
        "evidence_refs",
        "content_digest"
      ],
      "title": "ResolutionVectorArtifact",
      "type": "object"
    },
    "ScenarioAction": {
      "additionalProperties": false,
      "properties": {
        "action_kind": {
          "default": "PROCEDURE_INVOCATION",
          "enum": [
            "PROCEDURE_INVOCATION",
            "CURSOR_ITERATION",
            "HANDLER_ACTIVATION",
            "POST_LOOP_AGGREGATION",
            "TRANSACTION_COMPLETION"
          ],
          "title": "Action Kind",
          "type": "string"
        },
        "action_scope_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Scope Ref"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "invocation_contract_ref": {
          "title": "Invocation Contract Ref",
          "type": "string"
        },
        "procedure_identity_ref": {
          "title": "Procedure Identity Ref",
          "type": "string"
        }
      },
      "required": [
        "procedure_identity_ref",
        "invocation_contract_ref"
      ],
      "title": "ScenarioAction",
      "type": "object"
    },
    "ScenarioBlockerCode": {
      "enum": [
        "PARSER_RESULT_INCOMPLETE",
        "BEHAVIOR_BUNDLE_PARTIAL",
        "BEHAVIOR_SLICE_PARTIAL",
        "ORDERED_DECISION_NEGATED_ARM_DEPENDENCY_PARTIAL",
        "UNDECLARED_SYMBOL_REFERENCE",
        "PREDICATE_NORMALIZATION_PARTIAL",
        "OBVIOUS_PREDICATE_CONTRADICTION",
        "UNKNOWN_EFFECT_MODALITY",
        "UNRESOLVED_EFFECT_OBSERVABILITY",
        "TRANSACTION_SURVIVAL_UNRESOLVED",
        "MISSING_PRIMARY_EFFECT_OBLIGATION",
        "COMPILATION_BUDGET_EXCEEDED",
        "EVIDENCE_BINDING_INCOMPLETE",
        "SEMANTIC_RESULT_DIGEST_INVALID"
      ],
      "title": "ScenarioBlockerCode",
      "type": "string"
    },
    "ScenarioCompilationStatus": {
      "enum": [
        "SUCCEEDED",
        "BLOCKED",
        "FAILED"
      ],
      "title": "ScenarioCompilationStatus",
      "type": "string"
    },
    "ScenarioCompilerBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "analysis_result": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ],
          "title": "Analysis Result",
          "type": "string"
        },
        "budget_report_id": {
          "title": "Budget Report Id",
          "type": "string"
        },
        "configured_limits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Configured Limits",
          "type": "object"
        },
        "consumed": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Consumed",
          "type": "object"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "exceeded_limits": {
          "items": {
            "type": "string"
          },
          "title": "Exceeded Limits",
          "type": "array"
        },
        "reporting_integrity": {
          "const": "COMPLETE",
          "default": "COMPLETE",
          "title": "Reporting Integrity",
          "type": "string"
        }
      },
      "required": [
        "budget_report_id",
        "configured_limits",
        "consumed",
        "exceeded_limits",
        "analysis_result",
        "content_digest"
      ],
      "title": "ScenarioCompilerBudgetReport",
      "type": "object"
    },
    "ScenarioEffect": {
      "additionalProperties": false,
      "properties": {
        "caller_transaction_contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Transaction Contract Ref"
        },
        "effect_ref": {
          "title": "Effect Ref",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "modality": {
          "$ref": "#/$defs/EffectModality"
        }
      },
      "required": [
        "effect_ref",
        "modality"
      ],
      "title": "ScenarioEffect",
      "type": "object"
    },
    "ScenarioPrecondition": {
      "additionalProperties": false,
      "properties": {
        "classification_observation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Observation Ref"
        },
        "constraint_assessment_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Assessment Ref"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "modality": {
          "const": "MUST",
          "default": "MUST",
          "title": "Modality",
          "type": "string"
        },
        "precondition_id": {
          "title": "Precondition Id",
          "type": "string"
        },
        "technical_fact_ref": {
          "title": "Technical Fact Ref",
          "type": "string"
        }
      },
      "required": [
        "precondition_id",
        "technical_fact_ref"
      ],
      "title": "ScenarioPrecondition",
      "type": "object"
    },
    "ScenarioSpec": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ScenarioAction"
        },
        "alternative_or_conditional_effects": {
          "items": {
            "$ref": "#/$defs/ScenarioEffect"
          },
          "title": "Alternative Or Conditional Effects",
          "type": "array"
        },
        "analysis_budget_report_ref": {
          "title": "Analysis Budget Report Ref",
          "type": "string"
        },
        "artifact_revision_id": {
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "behavior_effect_bundle_ref": {
          "title": "Behavior Effect Bundle Ref",
          "type": "string"
        },
        "behavior_id": {
          "title": "Behavior Id",
          "type": "string"
        },
        "behavior_slice_ref": {
          "title": "Behavior Slice Ref",
          "type": "string"
        },
        "caller_transaction_contract_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Caller Transaction Contract Refs",
          "type": "array"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "created_by_compiler_version": {
          "const": "scenario-compiler-1.5",
          "default": "scenario-compiler-1.5",
          "title": "Created By Compiler Version",
          "type": "string"
        },
        "effect_closure_ref": {
          "title": "Effect Closure Ref",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_effects": {
          "items": {
            "$ref": "#/$defs/ScenarioEffect"
          },
          "title": "Expected Effects",
          "type": "array"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "title": "Finding Refs",
          "type": "array"
        },
        "ordered_decision_reduction_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ordered Decision Reduction Refs",
          "type": "array"
        },
        "platform_governance_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform Governance Ref"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/ScenarioPrecondition"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "predicate_graph_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Graph Ref"
        },
        "procedure_identity_ref": {
          "title": "Procedure Identity Ref",
          "type": "string"
        },
        "required_classification_slots": {
          "items": {
            "type": "string"
          },
          "title": "Required Classification Slots",
          "type": "array"
        },
        "required_vocabulary_slots": {
          "items": {
            "type": "string"
          },
          "title": "Required Vocabulary Slots",
          "type": "array"
        },
        "resolution_vector_ref": {
          "title": "Resolution Vector Ref",
          "type": "string"
        },
        "scenario_spec_id": {
          "title": "Scenario Spec Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_symbol_id": {
          "title": "Source Symbol Id",
          "type": "string"
        },
        "summary_refs": {
          "items": {
            "type": "string"
          },
          "title": "Summary Refs",
          "type": "array"
        },
        "symbol_lineage_id": {
          "title": "Symbol Lineage Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_spec_id",
        "behavior_id",
        "source_symbol_id",
        "symbol_lineage_id",
        "procedure_identity_ref",
        "artifact_revision_id",
        "behavior_effect_bundle_ref",
        "behavior_slice_ref",
        "action",
        "preconditions",
        "expected_effects",
        "alternative_or_conditional_effects",
        "effect_closure_ref",
        "resolution_vector_ref",
        "summary_refs",
        "analysis_budget_report_ref",
        "finding_refs",
        "evidence_refs",
        "required_classification_slots",
        "required_vocabulary_slots",
        "content_digest"
      ],
      "title": "ScenarioSpec",
      "type": "object"
    },
    "ScenarioSpecCompilationResult": {
      "additionalProperties": false,
      "properties": {
        "behavior_effect_bundle_ref": {
          "title": "Behavior Effect Bundle Ref",
          "type": "string"
        },
        "behavior_slice_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Behavior Slice Ref"
        },
        "blocker_details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocker Details",
          "type": "array"
        },
        "blockers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioBlockerCode"
          },
          "title": "Blockers",
          "type": "array"
        },
        "compilation_status": {
          "$ref": "#/$defs/ScenarioCompilationStatus"
        },
        "compiler_configuration_digest": {
          "title": "Compiler Configuration Digest",
          "type": "string"
        },
        "compiler_version": {
          "const": "scenario-compiler-1.5",
          "default": "scenario-compiler-1.5",
          "title": "Compiler Version",
          "type": "string"
        },
        "finding_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Finding Refs",
          "type": "array"
        },
        "input_digest_set": {
          "items": {
            "type": "string"
          },
          "title": "Input Digest Set",
          "type": "array"
        },
        "output_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Digest"
        },
        "scenario_spec_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Spec Ref"
        }
      },
      "required": [
        "compilation_status",
        "behavior_effect_bundle_ref",
        "behavior_slice_ref",
        "input_digest_set",
        "compiler_configuration_digest"
      ],
      "title": "ScenarioSpecCompilationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_reports": {
      "items": {
        "$ref": "#/$defs/ScenarioCompilerBudgetReport"
      },
      "title": "Budget Reports",
      "type": "array"
    },
    "classification_observations": {
      "items": {
        "$ref": "#/$defs/ClassificationObservation"
      },
      "title": "Classification Observations",
      "type": "array"
    },
    "compilation_results": {
      "items": {
        "$ref": "#/$defs/ScenarioSpecCompilationResult"
      },
      "title": "Compilation Results",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "effect_closures": {
      "items": {
        "$ref": "#/$defs/EffectClosureArtifact"
      },
      "title": "Effect Closures",
      "type": "array"
    },
    "parser_result_digest": {
      "title": "Parser Result Digest",
      "type": "string"
    },
    "procedure_identity_ref": {
      "title": "Procedure Identity Ref",
      "type": "string"
    },
    "resolution_vectors": {
      "items": {
        "$ref": "#/$defs/ResolutionVectorArtifact"
      },
      "title": "Resolution Vectors",
      "type": "array"
    },
    "scenario_specs": {
      "items": {
        "$ref": "#/$defs/ScenarioSpec"
      },
      "title": "Scenario Specs",
      "type": "array"
    },
    "schema_version": {
      "const": "scenario-spec-batch-0.1",
      "default": "scenario-spec-batch-0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_result_digest": {
      "title": "Semantic Result Digest",
      "type": "string"
    },
    "source_symbol_id": {
      "title": "Source Symbol Id",
      "type": "string"
    },
    "symbol_lineage_id": {
      "title": "Symbol Lineage Id",
      "type": "string"
    }
  },
  "required": [
    "parser_result_digest",
    "semantic_result_digest",
    "procedure_identity_ref",
    "source_symbol_id",
    "symbol_lineage_id",
    "classification_observations",
    "effect_closures",
    "resolution_vectors",
    "budget_reports",
    "scenario_specs",
    "compilation_results",
    "content_digest"
  ],
  "title": "ScenarioSpecBatchResult",
  "type": "object"
}
