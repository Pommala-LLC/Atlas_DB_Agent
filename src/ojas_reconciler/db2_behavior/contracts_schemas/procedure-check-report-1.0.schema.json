{
  "$defs": {
    "CheckState": {
      "enum": [
        "PASS",
        "FAIL",
        "CONDITIONAL",
        "INCONCLUSIVE",
        "NOT_EVALUATED",
        "NOT_APPLICABLE"
      ],
      "title": "CheckState",
      "type": "string"
    },
    "ProcedureCheck": {
      "additionalProperties": false,
      "properties": {
        "blocker_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocker Codes",
          "type": "array"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "condition_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Condition Refs",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CheckState"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "display_name",
        "state",
        "summary"
      ],
      "title": "ProcedureCheck",
      "type": "object"
    }
  },
  "$id": "procedure-check-report-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_run_ref": {
      "title": "Analysis Run Ref",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ProcedureCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "counts_by_state": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts By State",
      "type": "object"
    },
    "procedure_ref": {
      "title": "Procedure Ref",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "procedure-check-report-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Digest"
    }
  },
  "required": [
    "report_id",
    "procedure_ref",
    "analysis_run_ref",
    "checks",
    "counts_by_state",
    "content_digest"
  ],
  "title": "ProcedureCheckReport",
  "type": "object"
}
