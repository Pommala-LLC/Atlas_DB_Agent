{
  "$defs": {
    "RuntimeExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "RuntimeExecutionStatus",
      "type": "string"
    },
    "RuntimeInvocation": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/RuntimeInvocationParameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "procedure_name": {
          "title": "Procedure Name",
          "type": "string"
        },
        "procedure_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedure Schema"
        }
      },
      "required": [
        "invocation_id",
        "procedure_name",
        "parameters",
        "content_digest"
      ],
      "title": "RuntimeInvocation",
      "type": "object"
    },
    "RuntimeInvocationParameter": {
      "additionalProperties": false,
      "properties": {
        "parameter_mode": {
          "enum": [
            "IN",
            "OUT",
            "INOUT"
          ],
          "title": "Parameter Mode",
          "type": "string"
        },
        "parameter_name": {
          "title": "Parameter Name",
          "type": "string"
        },
        "type_text": {
          "title": "Type Text",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/RuntimeValue"
        }
      },
      "required": [
        "parameter_name",
        "parameter_mode",
        "type_text",
        "value"
      ],
      "title": "RuntimeInvocationParameter",
      "type": "object"
    },
    "RuntimeObservedParameter": {
      "additionalProperties": false,
      "properties": {
        "parameter_name": {
          "title": "Parameter Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/RuntimeValue"
        }
      },
      "required": [
        "parameter_name",
        "value"
      ],
      "title": "RuntimeObservedParameter",
      "type": "object"
    },
    "RuntimeRowChange": {
      "additionalProperties": false,
      "properties": {
        "after_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Digest"
        },
        "before_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Digest"
        },
        "effect_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Ref"
        },
        "operation": {
          "enum": [
            "INSERT",
            "UPDATE",
            "DELETE",
            "MERGE",
            "UNKNOWN"
          ],
          "title": "Operation",
          "type": "string"
        },
        "relation_name": {
          "title": "Relation Name",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        }
      },
      "required": [
        "relation_name",
        "operation"
      ],
      "title": "RuntimeRowChange",
      "type": "object"
    },
    "RuntimeTransactionEvent": {
      "additionalProperties": false,
      "properties": {
        "event_kind": {
          "enum": [
            "BEGIN",
            "COMMIT",
            "ROLLBACK",
            "CALLER_ROLLBACK",
            "UNKNOWN"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "event_kind",
        "sequence"
      ],
      "title": "RuntimeTransactionEvent",
      "type": "object"
    },
    "RuntimeValue": {
      "additionalProperties": false,
      "properties": {
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "value_kind": {
          "$ref": "#/$defs/RuntimeValueKind"
        }
      },
      "required": [
        "value_kind"
      ],
      "title": "RuntimeValue",
      "type": "object"
    },
    "RuntimeValueKind": {
      "enum": [
        "NULL",
        "STRING",
        "INTEGER",
        "DECIMAL",
        "BOOLEAN",
        "DATE",
        "TIMESTAMP",
        "RAW"
      ],
      "title": "RuntimeValueKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "called_routines": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Called Routines",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "execution_status": {
      "$ref": "#/$defs/RuntimeExecutionStatus"
    },
    "invocation": {
      "$ref": "#/$defs/RuntimeInvocation"
    },
    "observed_effect_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Observed Effect Refs",
      "type": "array"
    },
    "output_parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeObservedParameter"
      },
      "title": "Output Parameters",
      "type": "array"
    },
    "plan_digest": {
      "title": "Plan Digest",
      "type": "string"
    },
    "plan_ref": {
      "title": "Plan Ref",
      "type": "string"
    },
    "result_set_digests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Result Set Digests",
      "type": "array"
    },
    "row_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeRowChange"
      },
      "title": "Row Changes",
      "type": "array"
    },
    "schema_version": {
      "const": "runtime-observation-script-1.0",
      "default": "runtime-observation-script-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_id": {
      "title": "Script Id",
      "type": "string"
    },
    "sqlstate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sqlstate"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "transaction_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeTransactionEvent"
      },
      "title": "Transaction Events",
      "type": "array"
    }
  },
  "required": [
    "script_id",
    "plan_ref",
    "plan_digest",
    "invocation",
    "execution_status",
    "started_at",
    "ended_at",
    "content_digest"
  ],
  "title": "RuntimeObservationScript",
  "type": "object"
}
