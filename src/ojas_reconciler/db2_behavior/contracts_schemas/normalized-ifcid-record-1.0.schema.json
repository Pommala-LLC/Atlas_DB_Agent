  "$id": "normalized-ifcid-record-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Site adapter output. One record, already decoded.\n\nAdapter contract: ``recorded_at`` is a canonical timestamp and records are\nreturned in non-decreasing ``recorded_at`` order. The deriver verifies this\nrather than trusting it.\n\nPopulate ``statement_identity`` wherever the IFCID carries it, including on\ntext-bearing records. That is what lets a text record and a count record be\nrecognised as the same statement.",
  "properties": {
    "correlation": {
      "$ref": "#/$defs/IfcidCorrelationKey"
    },
    "executions": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executions"
    },
    "ifcid": {
      "$ref": "#/$defs/IfcidId"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "sqlcode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sqlcode"
    },
    "sqlstate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sqlstate"
    },
    "statement_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatementIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "statement_kind": {
      "default": "UNKNOWN",
      "enum": [
        "DYNAMIC",
        "STATIC",
        "UNKNOWN"
      ],
      "title": "Statement Kind",
      "type": "string"
    },
    "statement_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statement Text"
    },
    "table_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Table Name"
    },
    "table_qualifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Table Qualifier"
    }
  },
  "required": [
    "ifcid",
    "recorded_at",
    "correlation"
  ],
  "title": "NormalizedIfcidRecord",
  "type": "object"
}
