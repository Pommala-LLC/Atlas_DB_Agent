          "type": "string"
        },
        "scenario_spec_ref": {
          "title": "Scenario Spec Ref",
          "type": "string"
        },
        "verification_result_digest": {
          "title": "Verification Result Digest",
          "type": "string"
        },
        "verification_result_ref": {
          "title": "Verification Result Ref",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "verification_result_ref",
        "verification_result_digest",
        "scenario_spec_ref",
        "finding_refs",
        "content_digest"
