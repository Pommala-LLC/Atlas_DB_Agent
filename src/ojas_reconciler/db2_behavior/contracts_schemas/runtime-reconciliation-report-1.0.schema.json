        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "classification": {
          "default": "STATIC_RUNTIME_CONTRADICTION_CANDIDATE",
          "title": "Classification",
          "type": "string"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "title": "Finding Refs",
          "type": "array"
        },
        "promotion_status": {
