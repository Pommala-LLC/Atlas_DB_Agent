      "title": "Plan Batch Digest",
      "type": "string"
    },
    "schema_version": {
      "default": "runtime-reconciliation-report-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unmatched_execution_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unmatched Execution Refs",
      "type": "array"
    },
    "verification_batch_digest": {
      "title": "Verification Batch Digest",
      "type": "string"
    }
  },
  "required": [
    "plan_batch_digest",
    "verification_batch_digest",
    "counts_by_status",
    "content_digest"
