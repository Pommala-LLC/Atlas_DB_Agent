  "additionalProperties": false,
  "properties": {
    "approved_by_ref": {
      "title": "Approved By Ref",
      "type": "string"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "custody_agreement_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
