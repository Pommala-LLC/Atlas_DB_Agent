{
  "$defs": {
    "CompositionCandidateStatus": {
      "enum": [
        "SOURCE_CALL_RESOLVED",
        "TARGET_SOURCE_UNAVAILABLE",
        "TARGET_AMBIGUOUS",
        "DYNAMIC_TARGET"
      ],
      "title": "CompositionCandidateStatus",
      "type": "string"
    },
    "CompositionKind": {
      "enum": [
        "DIRECT_CALL",
        "EXTERNAL_SEQUENCE",
        "EVENT_DRIVEN",
        "BATCH_ORCHESTRATION",
        "APPLICATION_TRANSACTION"
      ],
      "title": "CompositionKind",
      "type": "string"
    },
    "CompositionTransactionRelationship": {
      "enum": [
        "SAME_UOW",
        "SEPARATE_COMMITTED_UOW",
        "CALLER_CONTROLLED",
        "UNKNOWN"
      ],
      "title": "CompositionTransactionRelationship",
      "type": "string"
    },
    "ParameterMapping": {
      "additionalProperties": false,
      "properties": {
        "downstream_ref": {
          "title": "Downstream Ref",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "mapping_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Expression"
        },
        "upstream_ref": {
          "title": "Upstream Ref",
          "type": "string"
        }
      },
      "required": [
        "upstream_ref",
        "downstream_ref"
      ],
      "title": "ParameterMapping",
      "type": "object"
    },
    "ProcedureCompositionCandidate": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "composition_kind": {
          "$ref": "#/$defs/CompositionKind"
        },
        "downstream_procedure_ref": {
          "title": "Downstream Procedure Ref",
          "type": "string"
        },
        "downstream_semantic_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Downstream Semantic Digest"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "invocation_site_ref": {
          "title": "Invocation Site Ref",
          "type": "string"
        },
        "invocation_text": {
          "title": "Invocation Text",
          "type": "string"
        },
        "parameter_mappings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParameterMapping"
          },
          "title": "Parameter Mappings",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CompositionCandidateStatus"
        },
        "transaction_relationship": {
          "$ref": "#/$defs/CompositionTransactionRelationship"
        },
        "upstream_procedure_ref": {
          "title": "Upstream Procedure Ref",
          "type": "string"
        },
        "upstream_semantic_digest": {
          "title": "Upstream Semantic Digest",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "composition_kind",
        "upstream_procedure_ref",
        "downstream_procedure_ref",
        "upstream_semantic_digest",
        "invocation_site_ref",
        "invocation_text",
        "transaction_relationship",
        "status",
        "evidence_refs"
      ],
      "title": "ProcedureCompositionCandidate",
      "type": "object"
    }
  },
  "$id": "composition-candidate-batch-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ProcedureCompositionCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "schema_version": {
      "default": "composition-candidate-batch-1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "candidates",
    "content_digest"
  ],
  "title": "CompositionCandidateBatch",
  "type": "object"
}
