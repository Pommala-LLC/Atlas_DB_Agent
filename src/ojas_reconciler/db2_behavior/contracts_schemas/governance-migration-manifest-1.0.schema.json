{
  "$id": "governance-migration-manifest-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "migrations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "filename": {
            "pattern": "^[0-9]{4}_[A-Za-z0-9_]+\\.sql$",
            "type": "string"
          },
          "migration_id": {
            "minLength": 1,
            "type": "string"
          },
          "previous_migration_digest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "migration_id",
          "filename",
          "digest",
          "previous_migration_digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "governance-migrations-1.0",
        "governance-migrations-1.1"
      ]
    }
  },
  "required": [
    "schema_version",
    "migrations"
  ],
  "type": "object"
}
