    "CompositionKind": {
      "enum": [
        "DIRECT_CALL",
        "EXTERNAL_SEQUENCE",
        "EVENT_DRIVEN",
        "BATCH_ORCHESTRATION",
        "APPLICATION_TRANSACTION"
      ],
      "title": "CompositionKind",
      "type": "string"
    },
    "CompositionTransactionRelationship": {
      "enum": [
        "SAME_UOW",
        "SEPARATE_COMMITTED_UOW",
        "CALLER_CONTROLLED",
        "UNKNOWN"
      ],
      "title": "CompositionTransactionRelationship",
      "type": "string"
    },
    "ConditionMapping": {
      "additionalProperties": false,
      "properties": {
        "entailment_status": {
          "title": "Entailment Status",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "exported_postcondition_ref": {
          "title": "Exported Postcondition Ref",
          "type": "string"
        },
        "imported_precondition_ref": {
          "title": "Imported Precondition Ref",
          "type": "string"
        }
      },
      "required": [
        "exported_postcondition_ref",
        "imported_precondition_ref",
        "entailment_status"
      ],
      "title": "ConditionMapping",
      "type": "object"
    },
    "ParameterMapping": {
      "additionalProperties": false,
      "properties": {
        "downstream_ref": {
          "title": "Downstream Ref",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "mapping_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Expression"
        },
        "upstream_ref": {
          "title": "Upstream Ref",
          "type": "string"
        }
      },
      "required": [
        "upstream_ref",
        "downstream_ref"
      ],
      "title": "ParameterMapping",
      "type": "object"
    }
  },
  "$id": "procedure-composition-contract-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
