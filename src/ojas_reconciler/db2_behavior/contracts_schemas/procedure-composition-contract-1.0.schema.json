    "upstream_procedure_ref": {
      "title": "Upstream Procedure Ref",
      "type": "string"
    },
    "upstream_semantic_digest": {
      "title": "Upstream Semantic Digest",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "composition_kind",
    "upstream_procedure_ref",
    "downstream_procedure_ref",
    "upstream_semantic_digest",
    "downstream_semantic_digest",
    "parameter_mappings",
    "condition_mappings",
    "transaction_relationship",
    "failure_disposition",
    "authority_ref",
    "evidence_refs",
    "effective_from",
    "content_digest"
