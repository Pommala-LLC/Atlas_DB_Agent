      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "downstream_procedure_ref": {
      "title": "Downstream Procedure Ref",
      "type": "string"
    },
    "downstream_semantic_digest": {
      "title": "Downstream Semantic Digest",
      "type": "string"
    },
    "effective_from": {
      "title": "Effective From",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
