{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pommala.com/contracts/readable-bdd-lint-report-1.0.schema.json",
  "title": "Readable BDD Lint Report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quality_gate_version",
    "parser_name",
    "parser_version",
    "status",
    "error_count",
    "warning_count",
    "issues",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "readable-bdd-lint-report-1.0"
    },
    "quality_gate_version": {
      "type": "string",
      "minLength": 1
    },
    "parser_name": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PASSED"
    },
    "error_count": {
      "const": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "ERROR",
              "WARNING"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
