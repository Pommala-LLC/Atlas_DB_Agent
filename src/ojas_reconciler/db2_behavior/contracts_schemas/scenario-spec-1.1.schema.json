{
  "$defs": {
    "EffectModality": {
      "enum": [
        "MUST",
        "MUST_IF_CALLER_CONTRACT_HOLDS",
        "MAY",
        "MUST_NOT",
        "UNKNOWN"
      ],
      "title": "EffectModality",
      "type": "string"
    },
    "ScenarioAction": {
      "additionalProperties": false,
      "properties": {
        "action_kind": {
          "default": "PROCEDURE_INVOCATION",
          "enum": [
            "PROCEDURE_INVOCATION",
            "CURSOR_ITERATION",
            "HANDLER_ACTIVATION",
            "POST_LOOP_AGGREGATION",
            "TRANSACTION_COMPLETION"
          ],
          "title": "Action Kind",
          "type": "string"
        },
        "action_scope_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Scope Ref"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "invocation_contract_ref": {
          "title": "Invocation Contract Ref",
          "type": "string"
        },
        "procedure_identity_ref": {
          "title": "Procedure Identity Ref",
          "type": "string"
        }
      },
      "required": [
        "procedure_identity_ref",
        "invocation_contract_ref"
      ],
      "title": "ScenarioAction",
      "type": "object"
    },
    "ScenarioEffect": {
      "additionalProperties": false,
      "properties": {
        "caller_transaction_contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Transaction Contract Ref"
        },
        "effect_ref": {
          "title": "Effect Ref",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "modality": {
          "$ref": "#/$defs/EffectModality"
        }
      },
      "required": [
        "effect_ref",
        "modality"
      ],
      "title": "ScenarioEffect",
      "type": "object"
    },
    "ScenarioPrecondition": {
      "additionalProperties": false,
      "properties": {
        "classification_observation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Observation Ref"
        },
        "constraint_assessment_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Assessment Ref"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "modality": {
          "const": "MUST",
          "default": "MUST",
          "title": "Modality",
          "type": "string"
        },
        "precondition_id": {
          "title": "Precondition Id",
          "type": "string"
        },
        "technical_fact_ref": {
          "title": "Technical Fact Ref",
          "type": "string"
        }
      },
      "required": [
        "precondition_id",
        "technical_fact_ref"
      ],
      "title": "ScenarioPrecondition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ScenarioAction"
    },
    "alternative_or_conditional_effects": {
      "items": {
        "$ref": "#/$defs/ScenarioEffect"
      },
      "title": "Alternative Or Conditional Effects",
      "type": "array"
    },
    "analysis_budget_report_ref": {
      "title": "Analysis Budget Report Ref",
      "type": "string"
    },
    "artifact_revision_id": {
      "title": "Artifact Revision Id",
      "type": "string"
    },
    "behavior_effect_bundle_ref": {
      "title": "Behavior Effect Bundle Ref",
      "type": "string"
    },
    "behavior_id": {
      "title": "Behavior Id",
      "type": "string"
    },
    "behavior_slice_ref": {
      "title": "Behavior Slice Ref",
      "type": "string"
    },
    "caller_transaction_contract_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Caller Transaction Contract Refs",
      "type": "array"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "created_by_compiler_version": {
      "const": "scenario-compiler-1.5",
      "default": "scenario-compiler-1.5",
      "title": "Created By Compiler Version",
      "type": "string"
    },
    "effect_closure_ref": {
      "title": "Effect Closure Ref",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expected_effects": {
      "items": {
        "$ref": "#/$defs/ScenarioEffect"
      },
      "title": "Expected Effects",
      "type": "array"
    },
    "finding_refs": {
      "items": {
        "type": "string"
      },
      "title": "Finding Refs",
      "type": "array"
    },
    "ordered_decision_reduction_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Ordered Decision Reduction Refs",
      "type": "array"
    },
    "platform_governance_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Governance Ref"
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/ScenarioPrecondition"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "predicate_graph_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicate Graph Ref"
    },
    "procedure_identity_ref": {
      "title": "Procedure Identity Ref",
      "type": "string"
    },
    "required_classification_slots": {
      "items": {
        "type": "string"
      },
      "title": "Required Classification Slots",
      "type": "array"
    },
    "required_vocabulary_slots": {
      "items": {
        "type": "string"
      },
      "title": "Required Vocabulary Slots",
      "type": "array"
    },
    "resolution_vector_ref": {
      "title": "Resolution Vector Ref",
      "type": "string"
    },
    "scenario_spec_id": {
      "title": "Scenario Spec Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_symbol_id": {
      "title": "Source Symbol Id",
      "type": "string"
    },
    "summary_refs": {
      "items": {
        "type": "string"
      },
      "title": "Summary Refs",
      "type": "array"
    },
    "symbol_lineage_id": {
      "title": "Symbol Lineage Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_spec_id",
    "behavior_id",
    "source_symbol_id",
    "symbol_lineage_id",
    "procedure_identity_ref",
    "artifact_revision_id",
    "behavior_effect_bundle_ref",
    "behavior_slice_ref",
    "action",
    "preconditions",
    "expected_effects",
    "alternative_or_conditional_effects",
    "effect_closure_ref",
    "resolution_vector_ref",
    "summary_refs",
    "analysis_budget_report_ref",
    "finding_refs",
    "evidence_refs",
    "required_classification_slots",
    "required_vocabulary_slots",
    "content_digest"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}
