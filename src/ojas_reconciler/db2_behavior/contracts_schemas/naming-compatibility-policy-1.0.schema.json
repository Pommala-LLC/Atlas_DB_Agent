    "artifact_schema_compatibility": {
      "title": "Artifact Schema Compatibility",
      "type": "string"
    },
    "authority_ref": {
      "title": "Authority Ref",
      "type": "string"
    },
    "cli_aliases": {
      "items": {
        "type": "string"
      },
      "title": "Cli Aliases",
      "type": "array"
    },
    "cli_primary": {
      "title": "Cli Primary",
      "type": "string"
    },
    "commercial_name": {
      "title": "Commercial Name",
      "type": "string"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "distribution_name": {
      "title": "Distribution Name",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
