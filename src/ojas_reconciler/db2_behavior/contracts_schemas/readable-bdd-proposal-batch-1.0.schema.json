{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pommala.com/contracts/readable-bdd-proposal-batch-1.0.schema.json",
  "title": "Readable BDD Proposal Batch 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_scope",
    "review_required",
    "renderer_version",
    "procedure",
    "artifacts",
    "combined_text",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "readable-bdd-proposal-batch-1.0"},
    "authority_scope": {"const": "NON_AUTHORITATIVE_PROPOSAL"},
    "review_required": {"const": true},
    "renderer_version": {"type": "string", "minLength": 1},
    "procedure": {"type": "string", "minLength": 1},
    "combined_text": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "schema_version",
          "authority_scope",
          "review_required",
          "renderer_version",
          "behavior_id",
          "scenario_spec_ref",
          "technical_gherkin_artifact_ref",
          "source_symbol_id",
          "symbol_lineage_id",
          "artifact_revision_id",
          "evidence_refs",
          "text",
          "content_digest"
        ],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "schema_version": {"const": "readable-bdd-proposal-1.0"},
          "authority_scope": {"const": "NON_AUTHORITATIVE_PROPOSAL"},
          "review_required": {"const": true},
          "renderer_version": {"type": "string", "minLength": 1},
          "behavior_id": {"type": "string", "minLength": 1},
          "scenario_spec_ref": {"type": "string", "minLength": 1},
          "technical_gherkin_artifact_ref": {"type": "string", "minLength": 1},
          "source_symbol_id": {"type": "string", "minLength": 1},
          "symbol_lineage_id": {"type": "string", "minLength": 1},
          "artifact_revision_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "text": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
