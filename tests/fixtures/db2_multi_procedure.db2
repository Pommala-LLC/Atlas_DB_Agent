--#SET TERMINATOR @
CREATE PROCEDURE APP.VALIDATE_PAYOUT_REQUEST (IN P_ID INT)
LANGUAGE SQL
BEGIN
  UPDATE APP.PAYOUT SET STATUS = 'VALID' WHERE ID = P_ID;
END@

CREATE PROCEDURE APP.SETTLE_PAYOUT_REQUEST (IN P_ID INT)
LANGUAGE SQL
BEGIN
  CALL APP.VALIDATE_PAYOUT_REQUEST(P_ID);
  UPDATE APP.PAYOUT SET STATUS = 'SETTLED' WHERE ID = P_ID;
END@
